---
interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  heroImage?: string;
  readingTime?: string;
}
const { url, title, description, pubDate, category, heroImage, readingTime } = Astro.props;
const formatDate = (d: Date) => d.toLocaleDateString('nl-NL', { year: 'numeric', month: 'long', day: 'numeric' });
---
<a href={url} class="blog-card fade-in">
  <div class={`image ${heroImage ? '' : `image-placeholder cat-${category}`}`} data-category={category} data-label={category.replace(/-/g, ' ')}>
    {heroImage
      ? <img src={heroImage} alt={title} loading="lazy" data-fallback />
      : <span>{category.replace(/-/g, ' ')}</span>
    }
  </div>
  <div class="content">
    <p class="eyebrow">{category.replace(/-/g, ' ')}</p>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
    <div class="meta">
      <time>{formatDate(pubDate)}</time>
      {readingTime && <span>· {readingTime}</span>}
    </div>
  </div>
</a>

<style>
.blog-card {
  display: flex;
  flex-direction: column;
  background: var(--color-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  text-decoration: none;
  color: var(--color-text);
  border: 1px solid var(--color-border);
  transition: var(--transition);
  box-shadow: var(--shadow-sm);
}
.blog-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.image { aspect-ratio: 16 / 9; overflow: hidden; }
.image img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.blog-card:hover .image img { transform: scale(1.04); }
.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.85);
  font-family: var(--font-heading);
  font-size: 1.15rem;
  letter-spacing: 0.05em;
  text-transform: capitalize;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  position: relative;
}
.image-placeholder::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.18), transparent 55%);
}
.image-placeholder span {
  position: relative;
  padding: 0.4rem 1rem;
  border-radius: 999px;
  background: rgba(0,0,0,0.18);
  backdrop-filter: blur(2px);
}
.cat-darmgezondheid { background: linear-gradient(135deg, #C4754B 0%, #a55f3a 100%); }
.cat-spier-en-botklachten { background: linear-gradient(135deg, #2D5A3D 0%, #1f3f2a 100%); }
.cat-voeding-en-supplementen { background: linear-gradient(135deg, #4a7a5a 0%, #2D5A3D 100%); }
.cat-leefstijl { background: linear-gradient(135deg, #6B7A8F 0%, #3F4D63 100%); }
.cat-algemeen { background: linear-gradient(135deg, #1f3f2a 0%, #0f1f15 100%); }
.image-placeholder img { display: none; }
.content { padding: var(--space-md); display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
.content h3 { margin: 0; font-size: 1.2rem; }
.desc { color: var(--color-text-muted); font-size: 0.95rem; margin: 0; }
.meta { margin-top: auto; padding-top: 0.75rem; font-size: 0.85rem; color: var(--color-text-muted); }
</style>
