---
interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}
const {
  title = 'Klaar om uw klachten serieus aan te pakken?',
  text = 'Plan een gratis kennismakingsgesprek van 20 minuten. Geen verplichting — we kijken samen of mijn aanpak bij u past.',
  href = 'https://orthomoleculairzeist.clientomgeving.nl/afspraak-maken',
  label = 'Gratis kennismaking inplannen',
} = Astro.props;
---
<section class="cta-section">
  <div class="container">
    <div class="cta-inner">
      <h2>{title}</h2>
      <p>{text}</p>
      <a href={href} class="btn btn-accent" target="_blank" rel="noopener">{label}</a>
    </div>
  </div>
</section>

<style>
.cta-section { padding: var(--space-2xl) 0; }
.cta-inner {
  background: var(--color-primary);
  color: var(--color-white);
  padding: var(--space-xl);
  border-radius: var(--radius-lg);
  text-align: center;
  max-width: 880px;
  margin: 0 auto;
}
.cta-inner h2 { color: var(--color-white); margin-top: 0; }
.cta-inner p { font-size: 1.1rem; opacity: 0.92; max-width: 600px; margin: 0 auto var(--space-md); }
</style>
