---
// TODO: verifieer Formspree-ID met een echte testmail. Stuur een testbericht en bevestig op formspree.io.
const formspreeId = 'mkopyzbr';
---
<form action={`https://formspree.io/f/${formspreeId}`} method="POST" class="contact-form">
  <div class="row">
    <label>
      <span>Uw naam</span>
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label>
      <span>E-mailadres</span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
  </div>
  <label>
    <span>Onderwerp</span>
    <input type="text" name="subject" />
  </label>
  <label>
    <span>Uw bericht</span>
    <textarea name="message" rows="6" required></textarea>
  </label>
  {/* Honeypot voor spambots — verbergen voor menselijke gebruikers */}
  <label class="hp" aria-hidden="true">
    <span>Laat dit veld leeg</span>
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </label>
  <input type="hidden" name="_subject" value="Nieuw bericht via website Orthomoleculair Praktijk Zeist" />
  <p class="form-privacy">Uw gegevens worden alleen gebruikt om uw bericht te beantwoorden. Zie de <a href="/privacy-policy">privacyverklaring</a>.</p>
  <button type="submit" class="btn btn-accent">Verstuur bericht</button>
</form>

<style>
.contact-form { display: flex; flex-direction: column; gap: var(--space-md); max-width: 600px; }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
@media (max-width: 600px) { .row { grid-template-columns: 1fr; } }
.contact-form label { display: flex; flex-direction: column; gap: 0.35rem; font-weight: 500; font-size: 0.95rem; color: var(--color-primary-dark); }
.contact-form input,
.contact-form textarea {
  font-family: inherit;
  font-size: 1rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-white);
  color: var(--color-text);
  transition: var(--transition);
}
.contact-form input:focus,
.contact-form textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(45,90,61,0.1);
}
.contact-form button { align-self: flex-start; }
.hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
.form-privacy { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; }
.form-privacy a { color: var(--color-primary); }
</style>
