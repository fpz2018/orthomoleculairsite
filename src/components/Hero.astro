---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  ctaPrimary?: { href: string; label: string };
  ctaSecondary?: { href: string; label: string };
}
const { eyebrow, title, subtitle, ctaPrimary, ctaSecondary } = Astro.props;
---
<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="hero-subtitle">{subtitle}</p>
      <div class="hero-ctas">
        {ctaPrimary && <a href={ctaPrimary.href} class="btn btn-accent">{ctaPrimary.label}</a>}
        {ctaSecondary && <a href={ctaSecondary.href} class="btn btn-outline">{ctaSecondary.label}</a>}
      </div>
    </div>
  </div>
</section>

<style>
.hero {
  padding: var(--space-2xl) 0 var(--space-xl);
  background: linear-gradient(170deg, var(--color-secondary) 0%, var(--color-bg) 70%);
}
.hero-inner { max-width: 820px; }
.hero h1 { font-size: clamp(2.2rem, 5.5vw, 3.5rem); }
.hero-subtitle { font-size: 1.2rem; color: var(--color-text-muted); margin: var(--space-md) 0 var(--space-lg); max-width: 640px; }
.hero-ctas { display: flex; gap: var(--space-sm); flex-wrap: wrap; }
</style>
