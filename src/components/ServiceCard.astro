---
interface Props {
  title: string;
  href: string;
  symptoms: string[];
  description: string;
}
const { title, href, symptoms, description } = Astro.props;
---
<a href={href} class="service-card card fade-in">
  <h3>{title}</h3>
  <p>{description}</p>
  <ul>
    {symptoms.map((s) => <li>{s}</li>)}
  </ul>
  <span class="read-more">Lees meer →</span>
</a>

<style>
.service-card {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  color: var(--color-text);
  height: 100%;
}
.service-card h3 { color: var(--color-primary-dark); margin-top: 0; }
.service-card ul { margin-top: var(--space-sm); padding-left: 1.2rem; }
.service-card li { color: var(--color-text-muted); font-size: 0.95rem; }
.read-more {
  margin-top: auto;
  padding-top: var(--space-md);
  color: var(--color-accent);
  font-weight: 600;
}
.service-card:hover .read-more { color: var(--color-accent-dark); }
</style>
