---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schemaType?: 'localbusiness' | 'article' | 'person' | 'faq';
  article?: any;
  faq?: any;
}
const { title, description, image, type = 'website', schemaType = 'localbusiness', article, faq } = Astro.props;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <SEOHead title={title} description={description} image={image} type={type} />
  <SchemaMarkup type={schemaType} article={article} faq={faq} />
</head>
<body>
  <a href="#main" class="skip-link">Naar inhoud</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    // Ontbrekende blog-afbeeldingen vervangen door category-placeholder
    document.querySelectorAll('img[data-fallback]').forEach((img) => {
      img.addEventListener('error', () => {
        const parent = img.parentElement;
        if (!parent) return;
        const cat = parent.dataset.category || 'algemeen';
        const label = parent.dataset.label || cat;
        parent.classList.add('image-placeholder', 'cat-' + cat);
        const span = document.createElement('span');
        span.textContent = label;
        parent.innerHTML = '';
        parent.appendChild(span);
      });
    });
  </script>
</body>
</html>
