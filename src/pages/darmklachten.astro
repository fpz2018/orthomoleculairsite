---
import PageLayout from '../layouts/PageLayout.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';

const faqItems = [
  { question: 'Wat is het verschil tussen PDS en SIBO?', answer: 'PDS (prikkelbaredarmsyndroom) is een diagnose op basis van symptomen. SIBO is een mechanisme — bacteriële overgroei in de dunne darm — dat veel PDS-achtige klachten kan verklaren. Niet zelden blijkt "PDS" grotendeels door SIBO gedreven.' },
  { question: 'Welke testen gebruikt u bij darmklachten?', answer: 'Afhankelijk van het beeld: ontlastingonderzoek (via Microbiome Center), bloedonderzoek (via Biovis), eventueel een SIBO-ademtest. Ik kies alleen testen die bij uw vraagstelling passen.' },
  { question: 'Moet ik FODMAP gaan eten?', answer: 'Niet automatisch. FODMAP kan tijdelijk verlichting geven, maar langdurige strenge restrictie verschraalt het microbioom. Vaak werkt een onbewerkte basis met maaltijdvensters en gerichte herintroductie beter.' },
  { question: 'Wanneer moet ik eerst naar de huisarts?', answer: 'Bij alarmsymptomen: onbedoeld gewichtsverlies, bloed bij ontlasting, koorts, aanhoudende ernstige pijn of nachtelijke klachten. Orthomoleculaire therapie is aanvullend op reguliere zorg, geen vervanging.' },
];
---
<PageLayout
  title="Darmklachten behandelen in Zeist | Orthomoleculaire aanpak SIBO, PDS &amp; buikpijn"
  description="Last van een opgeblazen buik, PDS, SIBO of voedselintoleranties? Orthomoleculair Praktijk Zeist helpt u de oorzaak vinden, niet alleen de symptomen dempen."
  h1="Darmklachten? Ik help u de oorzaak vinden"
  eyebrow="Specialisatie · Darmgezondheid"
  intro="Een opgeblazen buik na elke maaltijd, wisselende ontlasting, vermoeidheid, voedselintoleranties die maar uitbreiden — vaak ligt de oorzaak dieper dan 'gevoelige darmen'. Vanuit orthomoleculair perspectief kijk ik naar darmflora, motiliteit, voeding, stress en eventueel SIBO."
  schemaType="faq"
  faq={faqItems}
>
  <h2>Welke darmklachten zie ik veel</h2>
  <ul>
    <li><strong>Opgeblazen gevoel en winderigheid</strong> — vaak na maaltijden, soms zo erg dat het lijkt of u zwanger bent</li>
    <li><strong>Prikkelbaredarmsyndroom (PDS / IBS)</strong> — wisselende ontlasting, krampen, urgentie</li>
    <li><strong>SIBO</strong> (Small Intestinal Bacterial Overgrowth) — een veel-gemiste oorzaak van PDS-achtige klachten</li>
    <li><strong>Voedselintoleranties</strong> — die zich lijken uit te breiden naar steeds meer voeding</li>
    <li><strong>Leaky gut</strong> en darmbarrière-problematiek</li>
    <li><strong>Brain fog en vermoeidheid</strong> die met uw darmen samenhangen</li>
  </ul>

  <h2>Mijn aanpak in het kort</h2>
  <p>Geen kant-en-klaar dieet of standaardprotocol. Wel een grondige analyse en een plan dat past bij uw leven.</p>
  <ol>
    <li><strong>Intake en analyse:</strong> uitgebreid gesprek over uw klachten, voedingsanamnese, leefstijl en medische voorgeschiedenis.</li>
    <li><strong>Eventueel onderzoek:</strong> ontlastingonderzoek (Microbiome Center), bloedonderzoek (Biovis), of SIBO-ademtest.</li>
    <li><strong>Persoonlijk plan:</strong> voeding, leefstijl, eventueel gerichte supplementen — gefaseerd opgebouwd (kalmeren → corrigeren → consolideren).</li>
    <li><strong>Begeleiding:</strong> vervolgconsulten om bij te sturen.</li>
  </ol>

  <h2>Lees verder over darmklachten</h2>
  <ul>
    <li><a href="/blog/buikklachten-het-kan-best-eens-een-sibo-zijn">Buikklachten? Het kan best eens een SIBO zijn</a></li>
    <li><a href="/blog/leptine-wat-is-het-en-waar-moet-ik-op-letten">Leptine: hormonale aansturing van honger en verzadiging</a></li>
  </ul>
</PageLayout>

<FAQ items={faqItems} title="Veelgestelde vragen over darmklachten" />
<CTA />
