---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import CTA from '../components/CTA.astro';

const faqItems = [
  { question: 'Hoe begint een traject bij u?', answer: 'U belt of mailt met uw klacht. In dat korte contact hoort u of orthomoleculaire therapie bij uw situatie past. Is dat zo, dan plannen we een uitgebreide intake van 60 tot 90 minuten waarin we uw klachten, voeding, leefstijl en voorgeschiedenis doornemen.' },
  { question: 'Voor welke klachten kunt u bij mij terecht?', answer: 'Vooral darm- en buikklachten (PDS, SIBO, voedselintoleranties), spier- en gewrichtsklachten (artrose, peesklachten, chronische rugpijn) en vermoeidheid/energieklachten. Bij twijfel: belt of mailt u even.' },
  { question: 'Wordt orthomoleculaire therapie vergoed?', answer: 'Veel aanvullende zorgverzekeringen vergoeden consulten geheel of gedeeltelijk omdat ik MBOG- en RBCZ-geregistreerd ben. Op de pagina vergoedingen leest u per zorgverzekeraar wat geldt.' },
  { question: 'Wat is het verschil met een diëtist of huisarts?', answer: 'Een orthomoleculair therapeut kijkt breder dan alleen voeding of standaardbehandeling: voeding, leefstijl, slaap, stress, supplementen en eventueel labonderzoek (bloed, ontlasting). Het is aanvullend op reguliere zorg, geen vervanging.' },
  { question: 'Hoe lang duurt een traject gemiddeld?', answer: 'Dat hangt af van uw klacht, maar voor de meeste mensen is het een traject van enkele maanden met een uitgebreide intake en 3–6 vervolgconsulten. Bij chronische klachten soms langer.' },
  { question: 'Werkt u ook online?', answer: 'Ja. Vervolgconsulten kunnen prima online via beeldbellen. De uitgebreide intake doe ik bij voorkeur op locatie in Zeist.' },
];
---
<BaseLayout
  title="Orthomoleculair Praktijk Zeist | Marc de Jong — Darmklachten, spierpijn & vermoeidheid"
  description="Persoonlijke orthomoleculaire therapie in Zeist voor darmklachten, spierpijn en vermoeidheid. MBOG- en RBCZ-geregistreerd. Belt of mailt u voor een afspraak."
  schemaType="faq"
  faq={faqItems}
>
  <Hero
    eyebrow="Orthomoleculair Praktijk Zeist"
    title="Eindelijk verlichting van uw buikklachten of spierpijn"
    subtitle="Orthomoleculaire therapie voor mensen die de oorzaak willen vinden, niet alleen het symptoom dempen. Persoonlijke aanpak door Marc de Jong — fysiotherapeut én orthomoleculair therapeut."
    ctaPrimary={{ href: '/contact', label: 'Neem contact op' }}
    ctaSecondary={{ href: '#specialisaties', label: 'Bekijk hoe ik u kan helpen' }}
  />

  <section class="about-short">
    <div class="container about-grid">
      <div class="about-photo">
        <img src="/images/marc.jpg" alt="Marc de Jong, orthomoleculair therapeut en fysiotherapeut in Zeist" width="320" height="400" loading="lazy" />
      </div>
      <div>
        <p class="eyebrow">Even voorstellen</p>
        <h2>Marc de Jong</h2>
        <p class="lead">Orthomoleculair Natuurgeneeskundig Therapeut (HBO), kPNI-therapeut en fysiotherapeut. Sinds 1990 werk ik in de gezondheidszorg, met een unieke combinatie van fysiotherapeutische én orthomoleculaire kennis.</p>
        <p>"Ik geloof niet in quick fixes. Wel in een grondige analyse, een plan dat past bij uw leven, en de tijd nemen om écht te begrijpen wat er speelt."</p>
        <p class="creds">MBOG <strong>TL1005</strong> · RBCZ <strong>240163R</strong></p>
        <a href="/over-mij" class="btn btn-outline">Lees meer over mij</a>
      </div>
    </div>
  </section>

  <section id="specialisaties" class="section-tinted">
    <div class="container">
      <p class="eyebrow">Waar ik u mee kan helpen</p>
      <h2>Drie specialisaties</h2>
      <div class="grid grid-3" style="margin-top: var(--space-lg)">
        <ServiceCard
          title="Darmklachten"
          href="/darmklachten"
          description="Opgeblazen gevoel, PDS, SIBO, voedselintoleranties of chronische buikpijn — vaak ligt de oorzaak dieper dan 'gevoelige darmen'."
          symptoms={['Opgeblazen buik en winderigheid','PDS / IBS','SIBO','Voedselintoleranties','Wisselende ontlasting']}
        />
        <ServiceCard
          title="Spier- &amp; botklachten"
          href="/spierpijn"
          description="Chronische pijn, artrose, peesklachten of fibromyalgie. Door mijn fysio-achtergrond kijk ik altijd én naar beweging én naar biochemie."
          symptoms={['Artrose (knie, heup, hand)','Chronische rugpijn','Achillespees-klachten','Fibromyalgie','Stijfheid en spierspanning']}
        />
        <ServiceCard
          title="Vermoeidheid"
          href="/vermoeidheid"
          description="Altijd moe, brain fog, weinig fut. Vaak een combinatie van tekorten, bijnierstress, schildklier of darmen."
          symptoms={['Aanhoudende vermoeidheid','Brain fog','Slechte slaap','Energiedip middag/avond','Bijnier­vermoeidheid']}
        />
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">Mijn werkwijze</p>
      <h2>Vier stappen naar inzicht en herstel</h2>
      <ol class="steps">
        <li><strong>Contact</strong><span>U belt of mailt uw klacht — we kijken of de aanpak bij u past.</span></li>
        <li><strong>Grondige analyse</strong><span>Uitgebreide intake van 60–90 min, eventueel met bloed- of ontlastingonderzoek.</span></li>
        <li><strong>Persoonlijk plan</strong><span>Binnen een week ontvangt u een concreet plan op maat: voeding, leefstijl, supplementen.</span></li>
        <li><strong>Begeleiding &amp; evaluatie</strong><span>Vervolgconsulten om bij te sturen en samen vooruitgang te zien.</span></li>
      </ol>
    </div>
  </section>

  <section class="section-tinted">
    <div class="container">
      <p class="eyebrow">Waarom Orthomoleculair Praktijk Zeist</p>
      <h2>Geregistreerde, brede zorg — zonder zweverig gedoe</h2>
      <div class="trust-grid">
        <div class="trust-item">
          <span class="trust-num">35+</span>
          <h3>Jaar ervaring</h3>
          <p>Sinds 1990 werkzaam in de gezondheidszorg, eerst als fysiotherapeut, daarna ook als orthomoleculair therapeut.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">2</span>
          <h3>HBO-opleidingen</h3>
          <p>Fysiotherapie én orthomoleculaire geneeskunde (Evenwijs), aangevuld met kPNI-specialisatie via Natura Foundation.</p>
        </div>
        <div class="trust-item">
          <span class="trust-num">MBOG · RBCZ</span>
          <h3>Volledig geregistreerd</h3>
          <p>Lid van MBOG (TL1005), RBCZ (240163R) en SCAG-aangesloten. Daardoor vaak vergoeding via aanvullende verzekering.</p>
        </div>
      </div>
    </div>
  </section>

  <FAQ items={faqItems} />

  <section class="contact-section">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Stuur me een bericht</h2>
        <p>Twijfelt u of mijn aanpak bij u past? Belt, mailt of stuurt u gerust een bericht. Ik reageer binnen 1–2 werkdagen.</p>
        <ul class="contact-list">
          <li><strong>Telefoon:</strong> <a href="tel:+31307210771">030 - 721 0771</a></li>
          <li><strong>E-mail:</strong> <a href="mailto:info@orthomoleculairpraktijkzeist.nl">info@orthomoleculairpraktijkzeist.nl</a></li>
          <li><strong>Adres:</strong> Laan van Vollenhove 20B, 3706 AA Zeist</li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
.about-short { padding: var(--space-2xl) 0; }
.about-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: var(--space-xl); align-items: center; }
@media (max-width: 800px) { .about-grid { grid-template-columns: 1fr; } }
.about-photo { display: flex; justify-content: center; }
.about-photo img {
  width: 320px;
  height: 400px;
  object-fit: cover;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}
@media (max-width: 800px) { .about-photo img { width: 100%; max-width: 360px; height: auto; aspect-ratio: 4/5; } }
.creds { color: var(--color-text-muted); font-size: 0.9rem; margin: var(--space-sm) 0 var(--space-md); }
.steps { list-style: none; counter-reset: step; padding: 0; margin-top: var(--space-lg); display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-md); }
.steps li {
  counter-increment: step;
  background: var(--color-white);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  position: relative;
  padding-top: calc(var(--space-md) + 24px);
}
.steps li::before {
  content: counter(step);
  position: absolute;
  top: var(--space-md);
  left: var(--space-md);
  width: 32px; height: 32px;
  border-radius: 50%;
  background: var(--color-accent);
  color: var(--color-white);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-heading);
  font-weight: 700;
}
.steps strong { display: block; color: var(--color-primary-dark); margin-bottom: 0.25rem; }
.steps span { color: var(--color-text-muted); font-size: 0.93rem; }

.trust-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-md); margin-top: var(--space-lg); }
.trust-item { background: var(--color-white); padding: var(--space-lg); border-radius: var(--radius-lg); border: 1px solid var(--color-border); }
.trust-item h3 { color: var(--color-primary-dark); margin: var(--space-sm) 0 var(--space-xs); }
.trust-item p { color: var(--color-text-muted); font-size: 0.97rem; margin: 0; }
.trust-num { display: inline-block; font-family: var(--font-heading); font-size: 1.8rem; font-weight: 700; color: var(--color-accent); line-height: 1; }

.contact-section { padding: var(--space-2xl) 0; }
.contact-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: var(--space-xl); }
@media (max-width: 800px) { .contact-grid { grid-template-columns: 1fr; } }
.contact-list { list-style: none; padding: 0; margin: var(--space-md) 0; }
.contact-list li { margin-bottom: 0.5rem; }
</style>
